{
 "$schema":"./node_modules/wrangler/config-schema.json",
 "name":"derech-tkuma-review",
 "account_id":"REPLACE_WITH_EXISTING_ACCOUNT_ID",
 "main":"./build/cloudflare-worker.ts",
 "compatibility_date":"2026-05-15",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":true,
 "preview_urls":false,
 "assets":{"binding":"ASSETS","run_worker_first":true},
 "d1_databases":[{"binding":"DB","database_name":"derech-tkuma-cms-review","database_id":"REPLACE_WITH_ISOLATED_D1_UUID","migrations_dir":"./drizzle"}],
 "r2_buckets":[{"binding":"BUCKET","bucket_name":"derech-tkuma-media-review"}],
 "vars":{
  "CF_ACCESS_ISSUER":"https://REPLACE_TEAM.cloudflareaccess.com",
  "CF_ACCESS_AUDIENCE":"REPLACE_WITH_APPLICATION_AUDIENCE",
  "PLATFORM_PUBLIC_ORIGIN":"https://derech-tkuma-review.REPLACE_SUBDOMAIN.workers.dev",
  "PLATFORM_RELEASE_STAGE":"review",
  "CMS_ADAPTER_MODE":"isolated-d1",
  "CMS_TENANT_ID":"derech",
  "CMS_SITE_ID":"derech-main",
  "CMS_OWNER_EMAIL":"REPLACE_OWNER_EMAIL"
 }
}
